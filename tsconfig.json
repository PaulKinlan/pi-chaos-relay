{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "types": ["node"]
  },
  "include": [
    "index.ts",
    "relay-client.ts",
    "config.ts",
    "poller.ts",
    "crypto.ts",
    "ws-client.ts",
    "scripts/**/*.ts",
    "test/**/*.ts"
  ]
}
